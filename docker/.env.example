# Timezone (e.g., America/New_York, America/Los_Angeles, Europe/London, UTC)
TZ=America/New_York

# Debian host user/group IDs so Plex has permission to read/write media & config
# Run `id -u` and `id -g` on your Debian server to check yours (usually 1000)
PUID=1000
PGID=1000

# Tailscale configuration
# Generate an auth key at: https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxxx
TS_HOSTNAME=plex-server
TS_EXTRA_ARGS=--accept-routes
TS_USERSPACE=false
TS_SERVE=false

# Automatically add the Tailscale IPv4 to Plex's customConnections preference
ADVERTISE_TAILSCALE_IP=true

# Plex Claim Token (valid for 4 minutes, only needed on first run)
# Get yours at: https://www.plex.tv/claim/
PLEX_CLAIM=

# Host port for Plex Web UI / streaming
PLEX_PORT=32400

# Host directory paths on your Debian server
MEDIA_DIR=/path/to/remote/movies
PLEX_CONFIG_DIR=./config
PLEX_TRANSCODE_DIR=./transcode
TAILSCALE_STATE_DIR=./tailscale
