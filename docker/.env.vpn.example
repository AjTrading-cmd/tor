# ==============================================================================
# Environment Configuration for docker-compose.vpn-media.yml
# Copy this file to .env.vpn:
#   cp .env.vpn.example .env.vpn
# ==============================================================================

# Timezone & User/Group IDs
TZ=America/Indiana/Indianapolis
PUID=1000
PGID=1000

# ------------------------------------------------------------------------------
# NordVPN Authentication (Choose Option A: WireGuard OR Option B: OpenVPN)
# ------------------------------------------------------------------------------

# OPTION A (Recommended - Faster): NordLynx WireGuard
# To get your WIREGUARD_PRIVATE_KEY automatically from your NordVPN Access Token:
#   curl -s -u token:<YOUR_NORDVPN_ACCESS_TOKEN> https://api.nordvpn.com/v1/users/services/credentials | jq -r .nordlynx_private_key
# Or while connected on host: sudo wg show nordlynx private-key
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=

# OPTION B: OpenVPN Service Credentials (from https://my.nordaccount.com/dashboard/nordvpn/manual-configuration/)
# If using Option B, set VPN_TYPE=openvpn and fill in OPENVPN_USER and OPENVPN_PASSWORD:
# VPN_TYPE=openvpn
OPENVPN_USER=
OPENVPN_PASSWORD=

# NordVPN Server Selection
SERVER_COUNTRIES=United States
SERVER_CITIES=Salt Lake City
SERVER_CATEGORIES=P2P

# ------------------------------------------------------------------------------
# Ports & Directories
# ------------------------------------------------------------------------------
QBIT_WEBUI_PORT=8080
QBIT_TORRENT_PORT=45906
JACKETT_PORT=9117
FLARESOLVERR_PORT=8191

QBIT_CONFIG_DIR=/home/juju/.config/qBittorrent-docker
TORRENTS_DIR=/home/juju/torrents
